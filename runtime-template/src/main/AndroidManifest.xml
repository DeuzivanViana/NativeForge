<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The label is a literal string (not a resource) so the IDE can patch it in the binary manifest. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NativeForge App"
        android:theme="@style/Theme.NativeForgeRuntime">

        <activity
            android:name="io.nativeforge.runtime.template.LauncherActivity"
            android:exported="true"
            android:label="NativeForge App"
            android:screenOrientation="unspecified"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
